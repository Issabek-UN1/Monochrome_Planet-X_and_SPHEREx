        "properties": {
          "detector": {
            "type": "integer",
            "title": "Detector"
          },
          "wavelength_min_um": {
            "type": "number",
            "title": "Wavelength Min Um"
          },
          "wavelength_max_um": {
            "type": "number",
            "title": "Wavelength Max Um"
          }
        },
        "type": "object",
        "required": [
          "detector",
          "wavelength_min_um",
          "wavelength_max_um"
        ],
        "title": "DetectorBand"
      },
      "ErrorInfo": {
