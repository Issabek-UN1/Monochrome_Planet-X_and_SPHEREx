          },
          {
            "name": "radius_deg",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 2,
              "exclusiveMinimum": 0,
              "default": 0.05,
              "title": "Radius Deg"
            }
          },
          {
            "name": "mjd_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mjd Min"
            }
          },
          {
            "name": "mjd_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mjd Max"
            }
          },
          {
            "name": "wavelength_min_um",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 5,
                  "minimum": 0.75
                },
                {
                  "type": "null"
                }
              ],
              "title": "Wavelength Min Um"
            }
          },
          {
            "name": "wavelength_max_um",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 5,
                  "minimum": 0.75
                },
                {
                  "type": "null"
                }
              ],
              "title": "Wavelength Max Um"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
