# irsa = real NASA/IPAC archive; demo = explicitly synthetic offline data.
SPHEREX_PROVIDER=irsa
SPHEREX_COLLECTIONS=["spherex_dr1","spherex_qr3"]
SPHEREX_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
SPHEREX_DATA_DIR=./data
SPHEREX_SEARCH_TTL_SECONDS=900
SPHEREX_HTTP_TIMEOUT_SECONDS=60
SPHEREX_MAX_DOWNLOAD_BYTES=67108864
SPHEREX_MAX_PENDING_JOBS=100
